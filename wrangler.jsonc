{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domain-scout",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
